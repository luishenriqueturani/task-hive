# --- API ---
NODE_ENV=development
APP_PORT=3001

# --- Base de dados (define UMA vez DB_USER / DB_PASSWORD / DB_NAME; não dupliques no ficheiro) ---
# Dev local (`npm run start:dev`): DB_HOST=127.0.0.1 e DB_PORT do Postgres no host.
# Docker Compose: o compose força na API DB_HOST=postgres e DB_PORT=5432 (ignora DB_HOST do .env no contentor).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=taskhive_app
# Obrigatório e não vazio (Node/pg SCRAM). Se tiver # ou espaços, usa aspas: DB_PASSWORD="segredo#1"
DB_PASSWORD=
DB_NAME=task_hive
#
# `npm run openapi:generate` no host: se o .env tem DB_HOST=postgres (nome Docker) e o script corre fora da rede do Compose, usa:
# DB_HOST_OPENAPI=127.0.0.1
# URL no OpenAPI/Swagger (opcional): OPENAPI_SERVER_URL=https://api.exemplo.com

# Segurança (gere valores fortes; nunca commits isto no Git)
JWT_SECRET=
# Access token (JWT) — default 1h. Ex.: 15m, 1h, 8h
JWT_ACCESS_EXPIRES_IN=1h
# Refresh token opaco — dias até expirar (default 30)
JWT_REFRESH_EXPIRES_DAYS=30
# Se o JWT_SECRET tiver $ e usares variáveis no docker-compose.yml, escapa no .env como $$ (ver documentação Docker Compose).
# Custo bcrypt (número de rounds). Alias legado: CRYPT_SAULT. Mínimo recomendado: 12.
CRYPT_SALT=12

# CSRF — valida Origin/Referer em login/registo quando headers presentes (browser).
# E2E/curl sem headers continuam permitidos. CSRF_ORIGIN_CHECK=false desactiva.
# CSRF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8080

# Swagger em /api e /api-json — HTTP Basic Auth
SWAGGER_USER=admin
SWAGGER_PASSWORD=

# Prometheus scrape — Bearer obrigatório em produção (NODE_ENV=production).
# Mesmo valor no contentor api e prometheus (backend/.env). Ex.: openssl rand -hex 24
METRICS_TOKEN=

# Obsoleto: ignorado pela app (use só migrations)
# DB_SYNCHRONIZE=true

# --- Seeder admin (uma vez; não commits a password) ---
# npm run seed:admin — obrigatório. Nome/email: git config user.name / user.email ou:
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Docker Compose (Postgres + API + Nginx): `docker compose up -d` ---
#
# Superuser do contentor (init + emergência). Não reutilizar como DB_USER.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=task_hive
#
# Utilizador remoto (pgAdmin, etc.): host:POSTGRES_PUBLISH_PORT
DB_REMOTE_USER=taskhive_remote
DB_REMOTE_PASSWORD=
#
# --- Docker Compose: portas no *host* (evitar conflito com outros projetos) ---
# Stack completa na raiz do monorepo: corre `./scripts/link-compose-env.sh`
# para o Compose ler estas variáveis (cria `.env` → `backend/.env`).
#
# Porta Postgres no host (pgAdmin / psql). Dentro da rede Docker a API usa sempre postgres:5432.
# POSTGRES_BIND=127.0.0.1 restringe ao localhost; 0.0.0.0 expõe na LAN.
POSTGRES_BIND=127.0.0.1
POSTGRES_PUBLISH_PORT=5432

# Entrada HTTP (Nginx) no host
HTTP_PORT=8080

# URLs públicas na LAN (browser) — ajustar ao IP/hostname real
# PUBLIC_APP_URL=http://192.168.1.34:8080
# PUBLIC_WS_URL=http://192.168.1.34:8080
# CSRF_ALLOWED_ORIGINS=http://192.168.1.34:8080

# --- Observabilidade (Prometheus + Grafana) ---
GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
# Obrigatório em produção / LAN; sem isto o contentor grafana não arranca.
GRAFANA_ADMIN_PASSWORD=
